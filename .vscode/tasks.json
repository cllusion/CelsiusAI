{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Celsius AI",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"& 'C:/Users/micro/Celsius AI/.venv/Scripts/python.exe' main.py; if ($LASTEXITCODE -ne 0) { Read-Host \"Process exited with code $LASTEXITCODE - press Enter to close\" } else { Read-Host \"Process finished - press Enter to close\" }"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"reveal": "always",
				"panel": "shared",
				"echo": true
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Initialize Project",
			"type": "process",
			"command": "C:/Users/micro/Celsius AI/.venv/Scripts/python.exe",
			"args": [
				"scripts/init_db.py"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run Tests",
			"type": "process",
			"command": "C:/Users/micro/Celsius AI/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"pytest",
				"tests/",
				"-v"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}