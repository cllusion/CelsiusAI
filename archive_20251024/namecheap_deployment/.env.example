# Celsius AI Environment Configuration
# Copy this to your server and rename to .env

# Flask Configuration
FLASK_ENV=production
SECRET_KEY=celsius_ai_secret_key_change_this
DEBUG=False

# Server Configuration  
HOST=0.0.0.0
PORT=5000

# Database
DATABASE_URL=sqlite:///celsius_activity.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=celsius.log

# Security
CORS_ORIGINS=*
API_KEY_REQUIRED=false

# Optional: Add your API keys here
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here