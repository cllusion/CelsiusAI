# Environment Configuration for Celsius AI
# Copy this file to .env and customize for your environment

# AI Configuration
# CELSIUS_AI_MODEL=microsoft/DialoGPT-medium
# CELSIUS_USE_OPENAI=false
# OPENAI_API_KEY=your_openai_api_key_here

# Threat Intelligence APIs
# VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
# MISP_URL=https://your-misp-instance.com
# MISP_KEY=your_misp_api_key_here

# Database Configuration
# CELSIUS_DB_URL=sqlite:///data/celsius_ai.db

# API Configuration
# CELSIUS_API_HOST=localhost
# CELSIUS_API_PORT=8080

# Logging
# CELSIUS_LOG_LEVEL=INFO

# Security Settings
# CELSIUS_QUARANTINE_PATH=quarantine/
# CELSIUS_SCAN_INTERVAL=300